#: ./units/orcs/Goblin_Frost.cfg:5
msgid "Frost Goblin"
msgstr ""

#. [unit_type], id=Frost Goblin, race=goblin
#: ./units/orcs/Goblin_Frost.cfg:22
msgid ""
"Frost Goblins are a subset of Goblin Impalers that have acquired more "
"sensible clothing for the cold, so they are not as helpless on the snow."
msgstr ""

#. [attack], type=pierce, range=melee
#: ./units/orcs/Goblin_Frost.cfg:33
msgid "pike"
msgstr ""

#. [attack], type=pierce, range=ranged
#. [attack], type=pierce, range=melee
