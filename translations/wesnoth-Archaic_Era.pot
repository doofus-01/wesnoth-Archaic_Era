#: ./units/ukians/Ukian_Wardog.cfg:77
msgid "torch"
msgstr ""

#. [unit_type], id=Ukian Seal, race=ukianseal
#: ./units/ukians/Seal.cfg:5
msgid "Seal"
msgstr ""

#. [unit_type], id=Ukian Seal, race=ukianseal
#. [unit_type], id=Ukian BladeSeal, race=ukianseal
#. [unit_type], id=Ukian IceSeal, race=ukianseal
#. [unit_type], id=Ukian LionSeal, race=ukianseal
#. [unit_type], id=Ukian PackSeal, race=ukianseal
#: ./units/ukians/Seal.cfg:20
#: ./units/ukians/Seal_Blade.cfg:22
#: ./units/ukians/Seal_Ice.cfg:21
#: ./units/ukians/Seal_Lion.cfg:21
#: ./units/ukians/Seal_Pack.cfg:20
msgid ""
"Seals are less attuned to human interaction than are dogs, but they can be "
"trained, and are better at swimming in the deep, cold water often encountered"
" in the north.  The Ukians also use tame seals to trick the wild seals they "
"sometimes hunt, which doesn't seem to bother the tame seals."
msgstr ""

#. [unit_type], id=Ukian BladeSeal, race=ukianseal
#: ./units/ukians/Seal_Blade.cfg:5
msgid "Iceblade Seal"
msgstr ""

